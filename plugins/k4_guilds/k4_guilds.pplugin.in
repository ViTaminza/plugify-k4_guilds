{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${K4_GUILDS_VERSION}",
	"name": "k4_guilds",
	"description": "In-game runtime and clan menu for the CS2 clan system whose database is owned by the clans2 website module (module_page_clans2). The site owns clan settings/type, roles, services, levels and duration; the plugin maintains the runtime columns the site displays (clans_main.bank from kill rewards, clans_players.kills/deaths/name/lastactivity) and implements the old Metamod in-game management menu with the native s2sdk menu API: clan list/info, join or apply (and cancel) depending on the clan type, pending invites, members/member cards, tops, guild chat, invite (online player list, accept/decline menu, expiry + cooldown), kick, join requests accept/decline and owner double-confirm disband. The optional hudmenu plugin supplies the player's own '!menu' choice; without it the menu uses the s2sdk builtin types. Actions mirror the site's SQL with race-safe guards and write the same clans_logs rows (join/exit/kick/request/request_accept/request_cancel); disband cascades like Clans::deleteClanCascade. Scoreboard clan tag defaults on. No existing table or column is altered and no additive tables are used. Configuration: config.json and databases.cfg (section k4_guilds, MySQL; SQLite is the fail-soft/test driver).",
	"author": "K4ryuu (K4-Guilds), adapted to the site-owned clans database",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/k4_guilds",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=3.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	]
}
